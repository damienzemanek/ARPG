    - Key: BattlemodeEffectStrategy_Piercing
      Value:
        icon: {fileID: 21300000, guid: b4ddf97f5abca7840b526c65f81c1846, type: 3}
        name: Piercing
        description: Next attack armor pierces with +50% DMG, removed when used.
    - Key: BattlemodeEffectStrategy_Stagnation
